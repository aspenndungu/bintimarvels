# Server-only configuration. Copy values into an uncommitted .env.local or approved deployment settings.
DATABASE_URL=
# Leave blank to require TLS in production. `disable` is accepted only for a loopback-only local review database.
DATABASE_SSL_MODE=
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SECRET=
ORDER_STATUS_SECRET=
INTERNAL_JOB_SECRET=
CRON_SECRET=
# Product and quote preview can remain visible while commerce is disabled.
# Live Maps endpoints fail closed unless DATABASE_URL and RATE_LIMIT_SECRET protect billable requests.
CATALOG_VISIBLE=false
# Server-only Maps key and exact fulfilment origin. Never expose these through NEXT_PUBLIC_* variables.
# Google Places and Routes calls are billable and quota-controlled; restrict this key to the required server APIs/IPs.
GOOGLE_MAPS_API_KEY=
WAREHOUSE_LAT=
WAREHOUSE_LNG=
# Keep false until Lorna approves the production rider/courier rate card. When false, no numeric delivery price is returned.
DELIVERY_RATE_CARD_APPROVED=false
# Automated tests may set MAPS_TEST_MODE=true outside production; never set it in a live deployment.
MAPS_TEST_MODE=false
# Payment gates remain false until the Pesapal merchant account, IPN and reconciliation test are approved.
COMMERCE_ENABLED=false
CATALOG_APPROVED=false
PRODUCTION_PAYMENT_GATE_APPROVED=false
# School support is a separate gate. Keep false until finance handling and Pesapal are approved.
SCHOOL_SUPPORT_ENABLED=false
SCHOOL_SUPPORT_FINANCE_APPROVED=false
# Use `sandbox` only outside production. Production code refuses sandbox configuration.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Register the secret IPN URL with `npm run pesapal:register-ipn`, then copy the returned UUID here.
PESAPAL_NOTIFICATION_ID=
PESAPAL_CALLBACK_URL=https://example.com/api/pesapal/callback
PESAPAL_CANCELLATION_URL=https://example.com/payment-status?cancelled=1
# PESAPAL_IPN_TOKEN must be a random secret path segment; PESAPAL_IPN_URL must use the same value.
PESAPAL_IPN_TOKEN=
PESAPAL_IPN_URL=https://example.com/api/pesapal/ipn/replace-with-random-secret-token
FINANCE_WEBHOOK_URL=
# Exact host:port entries only, comma-separated; redirects are rejected.
FINANCE_WEBHOOK_ALLOWED_HOSTS=
FINANCE_WEBHOOK_SECRET=
